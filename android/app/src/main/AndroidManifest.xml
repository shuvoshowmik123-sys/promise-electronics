<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The channel Firebase falls back to when a message names one the app
          has not created. MainActivity creates admin_notifications on launch,
          but a notification can arrive before the app has ever been opened —
          and without this line that one lands in Android's own "Miscellaneous"
          bucket at default importance, silently.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="admin_notifications" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Needed to hand a downloaded APK to Android's installer.

      Without it the download finishes and the install screen never appears —
      the app looks like it did nothing. It does not grant a silent install:
      Android still shows its own confirmation, and on Android 8+ the person
      must additionally allow this app to install apps, which is a Settings
      screen the UI links to rather than assuming.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Only INTERNET was declared, which is why the app asked for nothing on
      first run and no notification ever arrived.

      From Android 13, POST_NOTIFICATIONS is a runtime permission, and a
      request for a permission the manifest does not declare does not prompt —
      it returns immediately as denied. So requestPermissions() looked like it
      worked, no dialog appeared, and push was silently impossible. Declaring
      it is what makes the phone actually ask.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Push wakes the device to show an alert and buzzes on arrival. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Photographing a set at intake, and choosing an existing photo.
      maxSdkVersion on the storage read: from Android 13 the photo picker
      grants access per image and the broad permission is refused anyway.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
      Location, for the GPS check-in on Shift and the pickup map.

      The panel asks for these the browser way, through navigator.geolocation.
      In a WebView that is refused unless the app itself holds the permission,
      and the refusal arrives with no prompt — which is why the app appeared
      never to ask for anything. Coarse is listed beside fine because Android 12
      and later let the person grant only approximate location, and a refused
      fine request should fall back rather than fail.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Fingerprint unlock, offered by the biometric plugin. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      The camera is used when present, not required to exist. Without this,
      Play and some vendor stores hide the app from tablets that have no
      camera, and a manager's tablet is exactly where this gets used.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
