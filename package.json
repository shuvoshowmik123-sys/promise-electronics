{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5082",
    "predev": "kill-port 5083 || true",
    "dev": "cross-env PORT=5083 NODE_ENV=development tsx server/index.ts",
    "api-docs:generate": "tsx scripts/generate-api-contract.ts",
    "build": "npm run api-docs:generate && tsx build.ts",
    "build:server": "tsx build-server.ts",
    "build:frontend": "npx vite build",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "TEST_LEVEL=1 playwright test e2e/customer/smoke.spec.ts e2e/admin/smoke.spec.ts",
    "test:e2e:headed": "cross-env HEADED=1 TEST_LEVEL=3 playwright test --headed",
    "test:e2e:mobile-headed": "cross-env HEADED=1 SLOW_MO=200 TEST_LEVEL=3 playwright test e2e/mobile --project=mobile-chrome --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test e2e/visual --update-snapshots",
    "qa:infra-pilots": "node qa-tooling/promise-qa/run-infra-pilots.mjs",
    "qa:infra-pilots:fast": "node qa-tooling/promise-qa/run-infra-pilots.mjs --mode FAST",
    "qa:multi-role-probe": "node qa-tooling/promise-qa/multi-role-context.mjs --probe",
    "qa:harness-tests": "node qa-tooling/promise-qa/harness-tests.mjs",
    "qa:mcp": "node qa-tooling/promise-qa/mcp-server.mjs",
    "qa:mcp:self-test": "node qa-tooling/promise-qa/mcp-self-test.mjs",
    "qa:validate-report": "node qa-tooling/promise-qa/validate-report.mjs",
    "qa:evidence-index": "node qa-tooling/promise-qa/generate-evidence-index.mjs",
    "qa:show-trace": "playwright show-trace",
    "db:push": "drizzle-kit push",
    "db:migrate:main": "tsx server/db-migrate-main.ts",
    "db:migrate:prod": "node scripts/migrate-production.mjs",
    "schema:audit:ledger": "tsx scripts/ledger-reconciliation-audit.ts",
    "schema:adoption:proof": "tsx scripts/disposable-baseline-adoption-proof.ts",
    "schema:adoption:emit-frozen-identity": "tsx scripts/emit-frozen-source-identity.ts",
    "schema:check:prod": "tsx scripts/check-production-schema.ts",
    "seed:policies": "node scripts/seed-policies.mjs",
    "app:sync": "npm run build && cap sync android && node scripts/apply-app-loader.mjs android/app/src/main/assets/public/index.html",
    "app:bundle": "node scripts/make-web-bundle.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "app:open": "cap open android"
  },
